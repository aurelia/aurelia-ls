{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "aurelia": [
        "../../aurelia/node_modules/aurelia"
      ],
      "@aurelia/router": [
        "../../aurelia/node_modules/@aurelia/router"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
