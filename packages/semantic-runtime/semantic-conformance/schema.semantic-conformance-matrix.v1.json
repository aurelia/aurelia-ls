{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurelia-ls.local/semantic-conformance-matrix.v1.schema.json",
  "title": "Aurelia semantic-runtime semantic conformance matrix",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "semantic-conformance-matrix.v1" },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    },
    "assertionSets": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertionSet" }
    }
  },
  "anyOf": [
    { "required": ["assertions"] },
    { "required": ["assertionSets"] }
  ],
  "$defs": {
    "domainAxis": {
      "enum": [
        "data-flow",
        "diagnostics",
        "edit-plan",
        "expression-semantics",
        "observation",
        "open-honesty",
        "overlays",
        "plugin-capabilities",
        "provenance",
        "query-contract",
        "query-locus",
        "resources",
        "runtime-lifecycle",
        "source-precision",
        "template-syntax",
        "type-system"
      ]
    },
    "aureliaDomain": {
      "enum": [
        "bindable-contracts",
        "plugin-capability-admission",
        "resource-registration",
        "router-composition",
        "runtime-composition",
        "runtime-api-boundary",
        "template-binding-syntax",
        "template-controller-scope",
        "template-expression-typing"
      ]
    },
    "coverageIntent": {
      "enum": [
        "boundary-contract",
        "domain-contract",
        "regression-contract"
      ]
    },
    "assertionKind": {
      "enum": [
        "candidate-honesty",
        "diagnostic-provenance-agreement",
        "edit-plan-old-text",
        "line-character-cursor-parity",
        "query-catalog-expectations",
        "query-expectations",
        "source-precision-agreement"
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "sourceLocus": {
      "type": "object",
      "description": "Authored source locator. Markers must be unique unless their corresponding occurrence field is explicit.",
      "properties": {
        "sourceFile": { "type": "string", "minLength": 1 },
        "marker": { "type": "string", "minLength": 1 },
        "markerOccurrence": { "$ref": "#/$defs/positiveInteger" },
        "token": { "type": "string", "minLength": 1 },
        "occurrence": { "$ref": "#/$defs/positiveInteger" },
        "position": { "enum": ["before-marker", "after-marker"] },
        "offsetDelta": { "type": "integer" },
        "startMarker": { "type": "string", "minLength": 1 },
        "startMarkerOccurrence": { "$ref": "#/$defs/positiveInteger" },
        "endMarker": { "type": "string", "minLength": 1 },
        "endMarkerOccurrence": { "$ref": "#/$defs/positiveInteger" }
      },
      "anyOf": [
        { "required": ["marker"] },
        { "required": ["token"] },
        { "required": ["startMarker", "endMarker"] }
      ],
      "additionalProperties": false
    },
    "querySpec": {
      "type": "object",
      "properties": {
        "sourceFile": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "const": false }
          ]
        },
        "cursor": {
          "oneOf": [
            { "$ref": "#/$defs/sourceLocus" },
            { "const": false }
          ]
        }
      },
      "additionalProperties": true
    },
    "rowExpectation": {
      "type": "object",
      "properties": {
        "source": { "$ref": "#/$defs/sourceLocus" }
      },
      "additionalProperties": true
    },
    "queryExpectation": {
      "type": "object",
      "properties": {
        "query": { "$ref": "#/$defs/querySpec" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/rowExpectation" }
        }
      },
      "additionalProperties": true
    },
    "assertionBase": {
      "type": "object",
      "required": [
        "id",
        "aureliaDomain",
        "capability",
        "domainAxis",
        "coverageIntent",
        "assertionKind",
        "requirement"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fixture": { "type": "string", "minLength": 1 },
        "sourceFile": { "type": "string", "minLength": 1 },
        "aureliaDomain": { "$ref": "#/$defs/aureliaDomain" },
        "capability": { "type": "string", "minLength": 1 },
        "domainAxis": { "$ref": "#/$defs/domainAxis" },
        "coverageIntent": { "$ref": "#/$defs/coverageIntent" },
        "assertionKind": { "$ref": "#/$defs/assertionKind" },
        "requirement": { "type": "string", "minLength": 1 },
        "cursor": { "$ref": "#/$defs/sourceLocus" },
        "expectations": {
          "type": "array",
          "items": { "$ref": "#/$defs/queryExpectation" }
        }
      },
      "additionalProperties": true
    },
    "assertion": {
      "$ref": "#/$defs/assertionBase"
    },
    "assertionSet": {
      "allOf": [
        { "$ref": "#/$defs/assertionBase" },
        {
          "type": "object",
          "required": ["cases"],
          "properties": {
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "aureliaDomain": { "$ref": "#/$defs/aureliaDomain" },
                  "coverageIntent": { "$ref": "#/$defs/coverageIntent" },
                  "cursor": { "$ref": "#/$defs/sourceLocus" },
                  "expectations": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/queryExpectation" }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
