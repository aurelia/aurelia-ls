{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurelia-ls.local/semantic-conformance-known-gaps.v1.schema.json",
  "title": "Aurelia semantic-runtime semantic conformance known gaps",
  "type": "object",
  "required": ["schemaVersion", "knownGaps"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "semantic-conformance-known-gaps.v1" },
    "knownGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertionId",
          "status",
          "failureBucket",
          "firstObserved",
          "rationale"
        ],
        "properties": {
          "assertionId": { "type": "string", "minLength": 1 },
          "status": { "const": "known-gap" },
          "failureBucket": { "type": "string", "minLength": 1 },
          "firstObserved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
