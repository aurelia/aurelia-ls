{
  "name": "aurelia-2",
  "displayName": "Aurelia 2",
  "description": "Language tooling for Aurelia 2 templates — diagnostics, completions, go-to-definition, and more.",
  "version": "0.5.0",
  "publisher": "AureliaEffect",
  "icon": "images/logo.png",
  "type": "module",
  "api": "none",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Aurelia project analysis requires a Node-accessible workspace filesystem."
    }
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aurelia",
    "aurelia2",
    "template",
    "html",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelia/aurelia-ls"
  },
  "license": "MIT",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:aurelia-html",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "workspaceContains:**/aurelia.project.json",
    "workspaceContains:node_modules/@aurelia/runtime-html/package.json",
    "workspaceContains:node_modules/aurelia/package.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aurelia-html",
        "aliases": [
          "Aurelia HTML",
          "aurelia-html"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonc",
        "filenames": [
          "aurelia.project.json"
        ]
      }
    ],
    "grammars": [
      {
        "language": "aurelia-html",
        "scopeName": "text.html.aurelia",
        "path": "./syntaxes/aurelia-html.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "aurelia-html",
          "source.css": "css",
          "source.js": "javascript",
          "source.python": "python",
          "source.smarty": "smarty"
        },
        "tokenTypes": {
          "meta.tag string.quoted": "other"
        }
      }
    ],
    "htmlLanguageParticipants": [
      {
        "languageId": "aurelia-html",
        "autoInsert": true
      }
    ],
    "snippets": [
      {
        "language": "aurelia-html",
        "path": "./snippets/html.code-snippets"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "aurelia-html": "html"
      },
      "[aurelia-html]": {
        "editor.suggest.insertMode": "replace"
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/aurelia.project.json",
        "url": "./dist/schemas/aurelia.project.jsonc.schema.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "aureliaElement",
        "superType": "class",
        "description": "An Aurelia custom or framework element."
      },
      {
        "id": "aureliaAttribute",
        "superType": "decorator",
        "description": "An Aurelia custom attribute."
      },
      {
        "id": "aureliaBindable",
        "superType": "property",
        "description": "An Aurelia bindable attribute."
      },
      {
        "id": "aureliaController",
        "superType": "macro",
        "description": "An Aurelia template controller."
      },
      {
        "id": "aureliaCommand",
        "superType": "keyword",
        "description": "An Aurelia binding command."
      },
      {
        "id": "aureliaConverter",
        "superType": "function",
        "description": "An Aurelia value converter."
      },
      {
        "id": "aureliaBehavior",
        "superType": "decorator",
        "description": "An Aurelia binding behavior."
      },
      {
        "id": "aureliaMetaElement",
        "superType": "keyword",
        "description": "An Aurelia template metadata element."
      },
      {
        "id": "aureliaEvent",
        "superType": "event",
        "description": "An event name in Aurelia listener syntax."
      },
      {
        "id": "aureliaModifier",
        "superType": "keyword",
        "description": "An Aurelia listener modifier."
      },
      {
        "id": "aureliaExpression",
        "superType": "operator",
        "description": "A delimiter in an Aurelia template expression."
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "aureliaResourceExplorer",
          "name": "Aurelia Resources",
          "when": "aurelia.active"
        }
      ]
    },
    "commands": [
      {
        "command": "aurelia.explainAttributeInterpretation",
        "title": "Explain Attribute",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.explainFrameworkCapability",
        "title": "Explain Diagnostic",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.explainBindingUncertainty",
        "title": "Explain Binding",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.explainResourceAvailability",
        "title": "Explain Availability in Active Template",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.refreshResourceExplorer",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.reviewAnalysisLimitations",
        "title": "Review Analysis Limitations",
        "icon": "$(info)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.goToResource",
        "title": "Go to Resource...",
        "icon": "$(search)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.goToAvailableResource",
        "title": "Go to Resource Available to Active Template...",
        "icon": "$(target)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openResourceDeclaration",
        "title": "Open Declaration",
        "icon": "$(go-to-file)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openResourceImplementation",
        "title": "Open Implementation",
        "icon": "$(file-code)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openResourceToSide",
        "title": "Open to Side",
        "icon": "$(split-horizontal)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.retryResourceProject",
        "title": "Retry Resource Discovery",
        "icon": "$(refresh)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openAureliaOutput",
        "title": "Open Aurelia Output",
        "icon": "$(output)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openRelatedFile",
        "title": "Open Related File",
        "category": "Aurelia"
      }
    ],
    "keybindings": [
      {
        "command": "aurelia.openRelatedFile",
        "key": "alt+r",
        "when": "aurelia.active && aurelia.documentOwned && editorTextFocus && (editorLangId == html || editorLangId == aurelia-html || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aurelia.goToResource",
          "when": "view == aureliaResourceExplorer",
          "group": "navigation@1"
        },
        {
          "command": "aurelia.goToAvailableResource",
          "when": "view == aureliaResourceExplorer && aurelia.activeTemplateOwned",
          "group": "navigation@2"
        },
        {
          "command": "aurelia.refreshResourceExplorer",
          "when": "view == aureliaResourceExplorer",
          "group": "navigation@3"
        },
        {
          "command": "aurelia.openAureliaOutput",
          "when": "view == aureliaResourceExplorer && aurelia.resourceExplorerHasIssues",
          "group": "status@1"
        },
        {
          "command": "aurelia.reviewAnalysisLimitations",
          "when": "view == aureliaResourceExplorer && aurelia.resourceExplorerHasAnalysisReview",
          "group": "analysis@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aurelia.explainResourceAvailability",
          "when": "view == aureliaResourceExplorer && aurelia.activeTemplateOwned && (viewItem == resource || viewItem == resourceWithImplementation || viewItem == resourceUnavailable)",
          "group": "availability@1"
        },
        {
          "command": "aurelia.openResourceDeclaration",
          "when": "view == aureliaResourceExplorer && (viewItem == resource || viewItem == resourceWithImplementation || viewItem == resourceAlias || viewItem == resourceBindable)",
          "group": "navigation@1"
        },
        {
          "command": "aurelia.openResourceImplementation",
          "when": "view == aureliaResourceExplorer && viewItem == resourceWithImplementation",
          "group": "navigation@2"
        },
        {
          "command": "aurelia.openResourceToSide",
          "when": "view == aureliaResourceExplorer && (viewItem == resource || viewItem == resourceWithImplementation || viewItem == resourceAlias || viewItem == resourceBindable)",
          "group": "navigation@3"
        },
        {
          "command": "aurelia.retryResourceProject",
          "when": "view == aureliaResourceExplorer && viewItem == resourceProjectIssue",
          "group": "resourceRecovery@1"
        },
        {
          "command": "aurelia.openAureliaOutput",
          "when": "view == aureliaResourceExplorer && (viewItem == resourceProjectIssue || viewItem == resourceProjectUnsupported)",
          "group": "resourceRecovery@2"
        }
      ],
      "editor/context": [
        {
          "command": "aurelia.goToAvailableResource",
          "when": "aurelia.active && aurelia.activeTemplateOwned",
          "group": "aurelia@1"
        },
        {
          "command": "aurelia.openRelatedFile",
          "when": "aurelia.active && aurelia.documentOwned && (editorLangId == html || editorLangId == aurelia-html || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact)",
          "group": "aurelia@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aurelia.explainAttributeInterpretation",
          "when": "false"
        },
        {
          "command": "aurelia.explainFrameworkCapability",
          "when": "false"
        },
        {
          "command": "aurelia.explainBindingUncertainty",
          "when": "false"
        },
        {
          "command": "aurelia.explainResourceAvailability",
          "when": "false"
        },
        {
          "command": "aurelia.refreshResourceExplorer",
          "when": "aurelia.active"
        },
        {
          "command": "aurelia.goToResource",
          "when": "aurelia.active"
        },
        {
          "command": "aurelia.goToAvailableResource",
          "when": "aurelia.active && aurelia.activeTemplateOwned"
        },
        {
          "command": "aurelia.openRelatedFile",
          "when": "aurelia.active && aurelia.documentOwned && (editorLangId == html || editorLangId == aurelia-html || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact)"
        },
        {
          "command": "aurelia.openResourceDeclaration",
          "when": "false"
        },
        {
          "command": "aurelia.openResourceImplementation",
          "when": "false"
        },
        {
          "command": "aurelia.openResourceToSide",
          "when": "false"
        },
        {
          "command": "aurelia.retryResourceProject",
          "when": "false"
        },
        {
          "command": "aurelia.openAureliaOutput",
          "when": "false"
        },
        {
          "command": "aurelia.reviewAnalysisLimitations",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Aurelia",
      "properties": {
        "aurelia.activationMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Start a candidate server from cheap Aurelia evidence, then require semantic-runtime project-shape confirmation.",
            "Enable Aurelia tooling for this workspace folder without requiring automatic project-shape confirmation; an excluded parent subtree still wins.",
            "Exclude this workspace folder and its complete subtree from Aurelia tooling."
          ],
          "default": "auto",
          "scope": "resource",
          "order": 10,
          "description": "Control Aurelia project activation for each workspace folder."
        },
        "aurelia.inlayHints.bindingMode": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "order": 20,
          "description": "Show the resolved binding mode for implicit .bind commands."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle:minify",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "bundle:minify": "node esbuild.mjs --minify",
    "release:pack": "node scripts/vsix-artifact.mjs pack",
    "release:verify": "node scripts/vsix-artifact.mjs verify",
    "release:verify-installed": "node scripts/verify-installed-vsix.mjs",
    "watch:ide:process": "pnpm run bundle:watch",
    "test:extension-host": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs --worker --current-stable",
    "test:extension-host:worker": "pnpm run test:extension-host",
    "test:extension-host:ipc": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs --ipc --current-stable",
    "test:extension-host:current-stable": "pnpm run test:extension-host",
    "test:extension-host:minimum": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs --worker --minimum",
    "measure:extension-host:tails": "node scripts/collect-extension-host-tails.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "devDependencies": {
    "@aurelia-ls/language-server": "workspace:*",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.24.2",
    "jszip": "3.10.1",
    "mocha": "^11.7.6",
    "vscode-json-languageservice": "5.7.2"
  }
}
