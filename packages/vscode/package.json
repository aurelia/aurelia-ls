{
  "name": "aurelia-2",
  "displayName": "Aurelia 2",
  "description": "Language tooling for Aurelia 2 templates — diagnostics, completions, go-to-definition, and more.",
  "version": "0.4.4",
  "publisher": "AureliaEffect",
  "icon": "images/logo.png",
  "type": "module",
  "api": "none",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Aurelia project analysis requires a Node-accessible workspace filesystem."
    }
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aurelia",
    "aurelia2",
    "template",
    "html",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelia/aurelia-ls"
  },
  "license": "MIT",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "workspaceContains:**/aurelia.project.json",
    "workspaceContains:node_modules/@aurelia/runtime-html/package.json",
    "workspaceContains:node_modules/aurelia/package.json"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/aurelia.project.json",
        "url": "./dist/schemas/aurelia.project.schema.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "aureliaResourceExplorer",
          "name": "Aurelia Resources",
          "when": "aurelia.active"
        }
      ]
    },
    "commands": [
      {
        "command": "aurelia.refreshResourceExplorer",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.goToResource",
        "title": "Go to Resource...",
        "icon": "$(search)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.goToAvailableResource",
        "title": "Go to Resource Available to Active Template...",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openRelatedFile",
        "title": "Open Related File",
        "category": "Aurelia"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aurelia.goToResource",
          "when": "view == aureliaResourceExplorer",
          "group": "navigation"
        },
        {
          "command": "aurelia.refreshResourceExplorer",
          "when": "view == aureliaResourceExplorer",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "aurelia.goToAvailableResource",
          "when": "aurelia.active && aurelia.documentOwned && editorLangId == html",
          "group": "aurelia@1"
        },
        {
          "command": "aurelia.openRelatedFile",
          "when": "aurelia.active && aurelia.documentOwned && (editorLangId == html || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact)",
          "group": "aurelia@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aurelia.refreshResourceExplorer",
          "when": "aurelia.active"
        },
        {
          "command": "aurelia.goToResource",
          "when": "aurelia.active"
        },
        {
          "command": "aurelia.goToAvailableResource",
          "when": "aurelia.active && aurelia.documentOwned"
        },
        {
          "command": "aurelia.openRelatedFile",
          "when": "aurelia.active && aurelia.documentOwned"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Aurelia",
      "properties": {
        "aurelia.activationMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Start a candidate server from cheap Aurelia evidence, then require semantic-runtime project-shape confirmation.",
            "Always run Aurelia tooling for this workspace folder.",
            "Exclude this workspace folder and its complete subtree from Aurelia tooling."
          ],
          "default": "auto",
          "scope": "resource",
          "order": 10,
          "description": "Control Aurelia project activation for each workspace folder."
        },
        "aurelia.inlayHints.bindingMode": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "order": 20,
          "description": "Show the resolved binding mode for implicit .bind commands."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle:minify",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "bundle:minify": "node esbuild.mjs --minify",
    "release:pack": "node scripts/vsix-artifact.mjs pack",
    "release:verify": "node scripts/vsix-artifact.mjs verify",
    "release:verify-installed": "node scripts/verify-installed-vsix.mjs",
    "watch:ide:process": "pnpm run bundle:watch",
    "test:extension-host": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs --worker --current-stable",
    "test:extension-host:worker": "pnpm run test:extension-host",
    "test:extension-host:ipc": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs --ipc --current-stable",
    "test:extension-host:current-stable": "pnpm run test:extension-host",
    "test:extension-host:minimum": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs --worker --minimum",
    "measure:extension-host:tails": "node scripts/collect-extension-host-tails.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "devDependencies": {
    "@aurelia-ls/language-server": "workspace:*",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.24.2",
    "jszip": "3.10.1",
    "mocha": "^11.7.6"
  }
}
