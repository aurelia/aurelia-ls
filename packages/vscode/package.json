{
  "name": "aurelia-2",
  "displayName": "Aurelia 2",
  "description": "Language tooling for Aurelia 2 templates — diagnostics, completions, go-to-definition, and more.",
  "version": "0.4.4",
  "publisher": "AureliaEffect",
  "icon": "images/logo.png",
  "type": "module",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Aurelia project analysis requires a Node-accessible workspace filesystem."
    }
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aurelia",
    "aurelia2",
    "template",
    "html",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelia/aurelia-ls"
  },
  "license": "MIT",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "workspaceContains:node_modules/@aurelia/runtime-html/package.json",
    "workspaceContains:node_modules/aurelia/package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activityBar": [
        {
          "id": "aurelia",
          "title": "Aurelia",
          "icon": "images/logo.png"
        }
      ]
    },
    "views": {
      "aurelia": [
        {
          "id": "aureliaResourceExplorer",
          "name": "Resource Explorer",
          "when": "aurelia.active"
        }
      ]
    },
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/aurelia.json"
      }
    ],
    "commands": [
      {
        "command": "aurelia.refreshResourceExplorer",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.diagnosticsReport",
        "title": "Diagnostics Report",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.inspectAtCursor",
        "title": "Inspect at Cursor",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.findResource",
        "title": "Find Resource",
        "icon": "$(search)",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.showAvailableResources",
        "title": "Show Available Resources",
        "category": "Aurelia"
      },
      {
        "command": "aurelia.openRelatedFile",
        "title": "Open Related File",
        "category": "Aurelia"
      }
    ],
    "keybindings": [
      {
        "command": "aurelia.findResource",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "aurelia.active"
      },
      {
        "command": "aurelia.inspectAtCursor",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "aurelia.active && aurelia.documentOwned && editorTextFocus && editorLangId == html"
      },
      {
        "command": "aurelia.openRelatedFile",
        "key": "alt+o",
        "mac": "alt+o",
        "when": "aurelia.active && aurelia.documentOwned && editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aurelia.findResource",
          "when": "view == aureliaResourceExplorer",
          "group": "navigation"
        },
        {
          "command": "aurelia.refreshResourceExplorer",
          "when": "view == aureliaResourceExplorer",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "aurelia.inspectAtCursor",
          "when": "aurelia.active && aurelia.documentOwned && editorLangId == html",
          "group": "aurelia@1"
        },
        {
          "command": "aurelia.showAvailableResources",
          "when": "aurelia.active && aurelia.documentOwned && editorLangId == html",
          "group": "aurelia@2"
        },
        {
          "command": "aurelia.openRelatedFile",
          "when": "aurelia.active && aurelia.documentOwned && (editorLangId == html || editorLangId == typescript)",
          "group": "aurelia@3"
        },
        {
          "command": "aurelia.diagnosticsReport",
          "when": "aurelia.active && aurelia.documentOwned && editorLangId == html",
          "group": "aurelia@4"
        }
      ],
      "commandPalette": [
        {
          "command": "aurelia.refreshResourceExplorer",
          "when": "aurelia.active"
        },
        {
          "command": "aurelia.diagnosticsReport",
          "when": "aurelia.active && aurelia.documentOwned"
        },
        {
          "command": "aurelia.inspectAtCursor",
          "when": "aurelia.active && aurelia.documentOwned"
        },
        {
          "command": "aurelia.findResource",
          "when": "aurelia.active"
        },
        {
          "command": "aurelia.showAvailableResources",
          "when": "aurelia.active && aurelia.documentOwned"
        },
        {
          "command": "aurelia.openRelatedFile",
          "when": "aurelia.active && aurelia.documentOwned"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Aurelia",
      "properties": {
        "aurelia.activationMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Start a candidate server from cheap Aurelia evidence, then require semantic-runtime project-shape confirmation.",
            "Always run Aurelia tooling for this workspace folder.",
            "Never run Aurelia tooling for this workspace folder."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Control Aurelia project activation for each workspace folder."
        },
        "aurelia.features.commands": {
          "type": "boolean",
          "default": true,
          "description": "Enable Aurelia commands (find resource, open related file, inspect at cursor, show available resources, diagnostics report)."
        },
        "aurelia.features.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show transient Aurelia analysis progress in the status bar."
        },
        "aurelia.features.views": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Aurelia Resource Explorer sidebar panel."
        },
        "aurelia.features.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Append Aurelia taxonomy details (impact, actionability, category) to diagnostic messages."
        },
        "aurelia.features.inlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show semantic-runtime binding mode inlay hints in templates (for example, .bind resolved to toView or twoWay from the target bindable)."
        },
        "aurelia.experimental.ai": {
          "type": "boolean",
          "default": false,
          "description": "Enable experimental AI features."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "bundle:minify": "node esbuild.mjs --minify",
    "test:extension-host": "pnpm -w build && pnpm run bundle && node scripts/run-extension-host-tests.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@aurelia-ls/language-server": "workspace:*",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.24.0",
    "mocha": "^11.7.6"
  }
}
