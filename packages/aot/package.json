{
  "name": "@aurelia-ls/aot",
  "version": "0.1.0",
  "private": true,
  "description": "Aurelia AOT assurance and artifact projection over semantic-runtime",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "import": "./out/index.js",
      "types": "./out/index.d.ts"
    }
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "oracle:browser:built": "node scripts/run-browser-tree-oracle.mjs",
    "oracle:browser": "pnpm build && pnpm oracle:browser:built",
    "oracle:jit:built": "node scripts/run-jit-oracle.mjs",
    "oracle:jit": "pnpm build && pnpm oracle:jit:built",
    "test:built": "node ../../scripts/run-vitest.mjs --root ../.. --config vitest.config.ts packages/aot/test",
    "test": "pnpm build && pnpm typecheck:test && pnpm test:built",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true }); require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true }); require('node:fs').rmSync('tsconfig.test.tsbuildinfo', { force: true })\""
  },
  "dependencies": {
    "@aurelia-ls/semantic-runtime": "workspace:*",
    "magic-string": "0.30.21",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@aurelia/kernel": "link:../../aurelia/packages/kernel",
    "@aurelia/platform-browser": "link:../../aurelia/packages/platform-browser",
    "@aurelia/runtime-html": "link:../../aurelia/packages/runtime-html",
    "@aurelia/template-compiler": "link:../../aurelia/packages/template-compiler",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.4",
    "jsdom": "^25.0.1",
    "playwright": "1.57.0"
  }
}
