{
  "name": "@aurelia-ls/mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "import": "./out/index.js",
      "types": "./out/index.d.ts"
    }
  },
  "bin": {
    "au-mcp": "./out/server.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "pnpm build && node ../../scripts/run-vitest.mjs --root ../.. --config vitest.config.ts packages/mcp/test",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true }); require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "dev:invoke": "node ./out/dev/invoke.js",
    "dev:prompt": "node ./out/dev/prompt.js",
    "probe:stdio": "pnpm build && node scripts/probe-stdio.mjs",
    "release:pack": "pnpm build && node esbuild.mjs",
    "probe:release-tarball": "node scripts/probe-release-tarball.mjs",
    "probe:project-local-install": "node scripts/probe-project-local-install.mjs",
    "smoke:postinstall": "pnpm build && node scripts/probe-stdio.mjs",
    "contract:release": "pnpm build && node scripts/contract-release-docs.mjs && node scripts/contract-adversarial-surface.mjs && node scripts/contract-pattern-semantic-diagnostics.mjs && node scripts/contract-continuation-pass-through.mjs",
    "contract:release-docs": "node scripts/contract-release-docs.mjs",
    "contract:continuation-pass-through": "pnpm build && node scripts/contract-continuation-pass-through.mjs",
    "contract:adversarial-surface": "pnpm build && node scripts/contract-adversarial-surface.mjs",
    "contract:patterns-semantic": "pnpm build && node scripts/contract-pattern-semantic-diagnostics.mjs"
  },
  "dependencies": {
    "@aurelia-ls/patterns": "workspace:*",
    "@aurelia-ls/semantic-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^6.0.3"
  }
}
