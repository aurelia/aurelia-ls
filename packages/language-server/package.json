{
  "name": "@aurelia-ls/language-server",
  "version": "0.2.0",
  "description": "Language server for Aurelia 2 templates",
  "type": "module",
  "main": "./out/main.js",
  "types": "./out/main.d.ts",
  "exports": {
    ".": {
      "import": "./out/main.js",
      "types": "./out/main.d.ts"
    },
    "./protocol": {
      "import": "./out/protocol.js",
      "types": "./out/protocol.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelia/aurelia-ls"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "measure:incrementality": "node scripts/measure-incrementality.mjs",
    "measure:protocol": "node scripts/measure-protocol-responsiveness.mjs"
  },
  "dependencies": {
    "@aurelia-ls/semantic-runtime": "workspace:*",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13",
    "vscode-uri": "^3.0.8"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
