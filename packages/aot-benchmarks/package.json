{
  "name": "@aurelia-ls/aot-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Private reproducible performance and size portfolio for Aurelia JIT and AOT",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test:built": "node ../../scripts/run-vitest.mjs --root ../.. --config vitest.config.ts packages/aot-benchmarks/test",
    "test": "pnpm build && pnpm typecheck:test && pnpm test:built",
    "baseline:built": "node out/cli.js baseline",
    "baseline": "pnpm build && pnpm baseline:built",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true }); require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true }); require('node:fs').rmSync('tsconfig.test.tsbuildinfo', { force: true })\""
  },
  "dependencies": {
    "@aurelia/router": "link:../../aurelia/packages/router",
    "@aurelia/runtime": "link:../../aurelia/packages/runtime",
    "@aurelia/runtime-html": "link:../../aurelia/packages/runtime-html",
    "@aurelia-ls/aot": "workspace:*",
    "@aurelia-ls/aot-assurance": "workspace:*",
    "@aurelia-ls/aot-vite": "workspace:*",
    "@aurelia/vite-plugin": "link:../../aurelia/packages-tooling/vite-plugin",
    "aurelia": "link:../../aurelia/packages/aurelia",
    "playwright": "1.57.0",
    "source-map-support": "0.5.21",
    "tachometer": "0.7.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "6.0.3",
    "vitest": "^4.0.16"
  }
}
