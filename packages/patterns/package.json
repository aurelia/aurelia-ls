{
  "name": "@aurelia-ls/patterns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "import": "./out/index.js",
      "types": "./out/index.d.ts"
    }
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true }); require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "docs:snapshot": "pnpm build && node out/scripts/create-docs-snapshot.js",
    "corpus:review": "pnpm build && node out/scripts/corpus-review.js",
    "report": "pnpm build && node out/scripts/pattern-report.js",
    "report:local-collection": "pnpm report component.local-collection",
    "report:collection-server-query": "pnpm report collection.server-query",
    "report:form-native-submit": "pnpm report form.native-submit",
    "report:form-validation-submit": "pnpm report form.validation-submit",
    "report:form-server-validation-errors": "pnpm report form.server-validation-errors",
    "report:component-bindable-basic": "pnpm report component.bindable-basic",
    "report:component-slotted-layout": "pnpm report component.slotted-layout",
    "report:service-injected-state": "pnpm report service.injected-state",
    "report:component-custom-event": "pnpm report component.custom-event",
    "report:service-fetch-client": "pnpm report service.fetch-client",
    "report:form-choice-controls": "pnpm report form.choice-controls",
    "report:template-class-style-binding": "pnpm report template.class-style-binding",
    "report:template-value-converter-display": "pnpm report template.value-converter-display",
    "report:localization-i18n-locale-service": "pnpm report localization.i18n-locale-service",
    "report:template-focus-control": "pnpm report template.focus-control",
    "report:template-dom-ref": "pnpm report template.dom-ref",
    "report:template-debounced-input": "pnpm report template.debounced-input",
    "report:template-conditional-rendering": "pnpm report template.conditional-rendering",
    "report:component-lifecycle-cleanup": "pnpm report component.lifecycle-cleanup",
    "report:resource-custom-attribute": "pnpm report resource.custom-attribute",
    "report:shell-navigation-progress": "pnpm report shell.navigation-progress",
    "report:router-navigation-links": "pnpm report router.navigation-links",
    "report:router-active-navigation": "pnpm report router.active-navigation",
    "report:router-critical-loading": "pnpm report router.critical-loading",
    "report:router-route-parameters": "pnpm report router.route-parameters",
    "report:template-promise-secondary": "pnpm report template.promise-secondary",
    "report:template-attribute-binding": "pnpm report template.attribute-binding",
    "report:template-event-self": "pnpm report template.event-self",
    "report:template-update-trigger": "pnpm report template.update-trigger",
    "report:template-throttled-event": "pnpm report template.throttled-event",
    "report:template-let-variables": "pnpm report template.let-variables",
    "report:component-attribute-transfer": "pnpm report component.attribute-transfer",
    "report:component-dynamic-composition": "pnpm report component.dynamic-composition",
    "report:router-guard-redirect": "pnpm report router.guard-redirect",
    "report:router-auth-session-guard": "pnpm report router.auth-session-guard",
    "report:router-can-unload-dirty-form": "pnpm report router.can-unload-dirty-form",
    "report:router-relative-context-navigation": "pnpm report router.relative-context-navigation",
    "report:router-error-fallback": "pnpm report router.error-fallback",
    "report:service-fetch-configuration": "pnpm report service.fetch-configuration",
    "report:service-fetch-cancellation": "pnpm report service.fetch-cancellation",
    "report:service-fetch-interceptor": "pnpm report service.fetch-interceptor",
    "report:service-fetch-cache-policy": "pnpm report service.fetch-cache-policy",
    "report:collection-pagination": "pnpm report collection.pagination",
    "report:collection-virtual-repeat": "pnpm report collection.virtual-repeat",
    "report:collection-batch-selection": "pnpm report collection.batch-selection",
    "report:form-file-upload": "pnpm report form.file-upload",
    "report:resource-template-controller": "pnpm report resource.template-controller",
    "report:dialog-confirm-edit": "pnpm report dialog.confirm-edit",
    "report:template-portal-overlay": "pnpm report template.portal-overlay",
    "check:copyability": "pnpm build && node out/scripts/check-pattern-copyability.js",
    "check:evidence": "pnpm build && node out/scripts/check-pattern-reports.js",
    "check:quality": "pnpm build && pnpm test:contract:built && node out/scripts/check-pattern-reports.js && node out/scripts/check-pattern-copyability.js",
    "test": "pnpm check:quality",
    "test:contract": "pnpm build && pnpm test:contract:built",
    "test:contract:built": "node --test out/pattern-catalog.contract.test.js out/docs-snapshot.contract.test.js out/docs-reference.contract.test.js out/corpus-semantic-index.contract.test.js out/corpus-candidate-review.contract.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^6.0.3"
  }
}
